[user]
  email = {{ .email | quote }}
  name = {{ .full_name | quote }}
{{- if eq .chezmoi.os "darwin" }}
  signingkey = {{ .git.signing_key | quote }}
{{- else }}
  # The GPG key stays on the Mac. Linux boxes sign with their own SSH key
  # (devbox bootstrap creates it and adds it to GitHub as a signing key).
  signingkey = {{ joinPath .chezmoi.homeDir ".ssh/signing_ed25519.pub" | quote }}
{{- end }}

[alias]
  undo = reset --soft HEAD^

{{ if eq .chezmoi.os "darwin" -}}
[credential]
  helper = osxkeychain
{{- else -}}
# No keychain on Linux: GitHub HTTPS auth comes from `gh auth login`.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
{{- end }}

[core]
  editor = nvim
  pager = diff-so-fancy | less --tabs=4 -RFX

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

[commit]
  gpgsign = true

[rerere]
  enabled = true
  autoupdate = true

[color]
  ui = true
  diff = true

[merge]
  tool = nvimdiff

[mergetool]
  prompt = true
  path = nvim

[mergetool "nvimdiff"]
  cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[diff]
  tool = nvimdiff

[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[difftool]
  prompt = false

[pull]
  rebase = false

[gpg]
{{- if eq .chezmoi.os "darwin" }}
  program = gpg
{{- else }}
  format = ssh
[gpg "ssh"]
  allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" | quote }}
{{- end }}

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true

[spice "branchCreate"]
  commit = false

