# Settings for bootstrap.sh, which sources this file.
# Any value can be overridden by exporting it before running bootstrap.sh.
#
# Global mise tool versions live in devbox-mise.toml next to this file.
# The Metabase repo pins its own Java, Clojure, Babashka, Bun and Node in its
# mise.toml and .nvmrc.

# Claude Code channel or version for the native installer: stable, latest or X.Y.Z.
: "${CLAUDE_CODE_VERSION:=stable}"

# Claude Code plugins (space-separated). Marketplaces are GitHub repos.
: "${CLAUDE_PLUGIN_MARKETPLACES:=cursor/plugins metabase/mb-cli}"
: "${CLAUDE_PLUGINS:=pstack@cursor-plugins metabase-cli@metabase}"

# gh extensions (space-separated), installed once `gh auth login` is done.
: "${GH_EXTENSIONS:=github/gh-stack}"

# System tuning.
: "${DEVBOX_TIMEZONE:=Asia/Bangkok}"
: "${DEVBOX_SWAP_GB:=8}"
: "${DEVBOX_INOTIFY_WATCHES:=1048576}"
