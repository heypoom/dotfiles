# Pinned tool versions for the devbox. bootstrap.sh sources this file.
# Any value can be overridden by exporting it before running bootstrap.sh.
#
# Node, Java 21, Python, Bun, Rust and friends come from the dotfiles' global
# mise config (config/dot_config/mise/config.toml). The Metabase repo pins its
# own Java, Clojure, Babashka, Bun and Node in its mise.toml and .nvmrc.
# The tools below are the devbox extras, written to
# ~/.config/mise/conf.d/devbox.toml.

: "${NEOVIM_VERSION:=0.12.6}"
: "${BABASHKA_VERSION:=1.13.229}"
: "${CLOJURE_VERSION:=1.12.6.1673}"
: "${HERDR_VERSION:=0.9.5}"

# Claude Code channel or version for the native installer: stable, latest or X.Y.Z.
: "${CLAUDE_CODE_VERSION:=stable}"

# System tuning.
: "${DEVBOX_TIMEZONE:=Asia/Bangkok}"
: "${DEVBOX_SWAP_GB:=8}"
: "${DEVBOX_INOTIFY_WATCHES:=1048576}"
